<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Not shipped, not part of the public API - an offline, run-once-per-deployment ops tool, so
         it doesn't belong in a "tests" or "src" solution folder (mirrors Level5.LegacyAccountMigration). -->
    <RootNamespace>Level5.LegacyScoreMigration</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <!-- Direct ADO.NET driver for the raw, read-only V1 connection - deliberately NOT the EF
         provider package; this tool must never build an EF model over the legacy schema. Pinned
         to the same version Level5.Infrastructure's Npgsql.EntityFrameworkCore.PostgreSQL depends
         on, so there is exactly one Npgsql version in this tool's dependency graph. -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Composition root, same pattern as Level5.Api and Level5.LegacyAccountMigration - references
         Infrastructure directly to call AddLevel5Infrastructure. Zero reference, direct or
         transitive, to Level5Backend.csproj anywhere in this graph (enforced by
         Level5.Architecture.Tests.DependencyRuleTests). -->
    <ProjectReference Include="..\..\src\Level5.Application\Level5.Application.csproj" />
    <ProjectReference Include="..\..\src\Level5.Infrastructure\Level5.Infrastructure.csproj" />
  </ItemGroup>

</Project>
