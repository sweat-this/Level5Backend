{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "Level5BackendV2",
    "Audience": "Level5Client",
    "AccessTokenLifetimeMinutes": 15
  },
  // Standard OpenTelemetry baseline (issue #22). Otlp:Endpoint is intentionally empty by default -
  // traces/metrics are still recorded in-process either way, they just have nowhere to ship to
  // until an endpoint is configured, so no observability backend is required for local dev or CI.
  // Set via ConnectionStrings-style env vars in production, e.g.
  // Telemetry__Otlp__Endpoint=http://otel-collector:4317.
  "Telemetry": {
    "ServiceName": "Level5.Api.V2",
    "ServiceVersion": "1.0.0",
    "Otlp": {
      "Endpoint": ""
    }
  },
  // Addresses/CIDR ranges of reverse proxies whose X-Forwarded-For/-Proto headers should be
  // trusted. Leave empty unless this service actually runs behind one: anything listed here can
  // dictate the client IP the auth rate limiter partitions on.
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "AllowedHosts": "*"
}
