<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Level5.Domain\Level5.Domain.csproj" />
    <ProjectReference Include="..\..\src\Level5.Application\Level5.Application.csproj" />
    <ProjectReference Include="..\..\src\Level5.Infrastructure\Level5.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Level5.Api\Level5.Api.csproj" />
    <!-- Aliased because both this project and Level5.Api reference an assembly whose top-level
         statements generate a global-namespace `Program` class - without an alias, `Program`
         would be ambiguous between the two. See DependencyRuleTests.cs's `extern alias`. -->
    <ProjectReference Include="..\..\tools\Level5.LegacyAccountMigration\Level5.LegacyAccountMigration.csproj" Aliases="LegacyMigrationTool" />
    <ProjectReference Include="..\..\tools\Level5.LegacyScoreMigration\Level5.LegacyScoreMigration.csproj" Aliases="LegacyScoreMigrationTool" />
  </ItemGroup>

</Project>