# Optional overrides for docker-compose.local-db.yml and v2/scripts/db.ps1.
# Copy to .env (git-ignored) only if you need to change a default. Local development only -
# never put a shared, staging, or production credential here.
#
# LEVEL5_PG_PORT=5432
# LEVEL5_PG_USER=level5
# LEVEL5_PG_PASSWORD=<local-dev-password>
# LEVEL5_PG_CONTAINER_NAME=level5-postgres-local
